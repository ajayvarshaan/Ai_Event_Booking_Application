# ============================================
# Backend Environment Variables (copy to .env)
# ============================================

# Server
PORT=5000

# Database (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/event_booking

# JWT secret used to sign auth tokens
JWT_SECRET=change_this_to_a_long_random_string

# ============================================
# Google OAuth (Sign in with Google)
# ============================================
# Get these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web application) and
# add your frontend origin (e.g. http://localhost:3000) to
# "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# (Optional) Client secret is only needed if you later switch to a
# server-side OAuth code flow. Not required for the current ID-token flow.
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================
# Admin allowlist for Google sign-in
# ============================================
# Comma-separated list of emails that should get the 'admin' role
# when signing in with Google. Other Google users get 'user'.
ADMIN_EMAILS=admin@example.com,your_admin@gmail.com

